# Audio
persist.vendor.audio.fluence.voicecomm=true
persist.vendor.audio.voicecall.speaker.stereo=false

# Camera
persist.vendor.camera.physical.num=3

# Display
debug.sf.frame_rate_multiple_threshold=120
debug.sf.high_speed_scroll_factor=0
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.set_idle_timer_ms=500
ro.surface_flinger.uclamp.min=512
ro.vendor.display.sensortype=2
ro.vendor.display.svi=1
vendor.display.svi.config=1
vendor.display.svi.config_path=/vendor/etc/SVIConfig.xml

# Fingerprint
vendor.false_touch_quality=38

# NFC
persist.vendor.nfc.config_file_name=libnfc-SN220-UICC.conf

# Radio
ro.vendor.radio.imei.sv=1

# Audio
persist.vendor.audio.fluence.voicecomm=true
persist.vendor.audio.voicecall.speaker.stereo=false

# Camera
persist.vendor.camera.physical.num=3

# Display
debug.sf.frame_rate_multiple_threshold=120
debug.sf.high_speed_scroll_factor=0
ro.surface_flinger.has_wide_color_display=false
ro.surface_flinger.set_idle_timer_ms=500
ro.surface_flinger.uclamp.min=512
ro.vendor.display.sensortype=2
ro.vendor.display.svi=1
vendor.display.svi.config=1
vendor.display.svi.config_path=/vendor/etc/SVIConfig.xml

# Fingerprint
vendor.false_touch_quality=38

# NFC
persist.vendor.nfc.config_file_name=libnfc-SN220-UICC.conf

# Radio
ro.vendor.radio.imei.sv=1

# IMS/VoWiFi Configuration for US Mobile Warp (MCC 311 / MNC 480)

# Enable IMS Stack
persist.sys.ims.registration=1
persist.sys.ims.allow_roaming=true
persist.sys.ims.prefer_ims=true

# VoWiFi/WiFi Calling
persist.radio.vowifi=1
persist.radio.vowifi_mode_user_set=1
persist.radio.vowifi_mode_user_pref=2
persist.sys.wfc_mode=2
persist.vendor.wfc.feature_enabled=1

# IMS Domain
persist.sys.ims.domain=ims.uscc.net

# E911 Address Provisioning
persist.vendor.ims.e911_provisioned=0

# APN Configuration
persist.radio.apn_sel_by_default=1
persist.vendor.apn.use_static_config=1

# Enhanced Calling Features
persist.radio.ims_enabled=1
persist.radio.volte=1
persist.radio.vt=1

# Force APN visibility and selection on Android 16
ro.telephony.apn_default_enforced=1
ro.telephony.apn_list_version=1
persist.vendor.apn.show=1
ro.telephony.apn_list_override=true

# Explicitly set IMS APN
persist.radio.apn_preferred_for_ims=ims
persist.radio.apn_preferred_for_default=pwg

# Force WFC calling routing
persist.radio.wfc_voice_over_wifi_roaming=1
persist.radio.wfc_voice_over_wifi=1
persist.radio.calls_playout_delay=0
persist.radio.ims_audio_enabled=true

# IMS Registration and provisioning
persist.radio.ims_reg_delay=0
persist.radio.ims_dereg_delay=0
