    US Mobile Warp (MCC 311 / MNC 480) APN Configuration
-->
<apns version="8">
    <!-- US Mobile Default APN -->
    <apn
        mcc="311"
        mnc="480"
        carrier="US Mobile"
        apn="pwg"
        mmsc="http://pwg.mmsmvno.com/mms/wapenc"
        protocol="IPV4V6"
        roaming_protocol="IPV4V6"
        type="default,supl,mms"
    />

    <!-- US Mobile IMS APN (Critical for VoWiFi & E911) -->
    <apn
        mcc="311"
        mnc="480"
        carrier="US Mobile IMS"
        apn="ims"
        protocol="IPV4V6"
        roaming_protocol="IPV4V6"
        type="ims"
    />
</apns>
